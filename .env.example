# Copy to .env.local for development. In production these live in the pm2
# ecosystem file's env block (never commit real secrets).

# One shared application role owning only its own database.
DATABASE_URL=postgres://common_thread:change-me@127.0.0.1:5432/common_thread

# Separate database used only by database-backed tests.
TEST_DATABASE_URL=postgres://common_thread:change-me@127.0.0.1:5432/common_thread_test

# Signs the admin session cookie.
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-with-openssl-rand-base64-32

# AI puzzle generation (admin "Generer forslag"). Set the key for the provider
# you use. AI_MODEL is `anthropic:<model>` or `openai:<model>`; without it the
# provider whose key is set is used with its default model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=anthropic:claude-sonnet-5

# Puzzle "Nr. 1" is published on this date (YYYY-MM-DD).
LAUNCH_DATE=2026-10-01
